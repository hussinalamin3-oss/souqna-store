<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سوقنا - تسجيل الدخول</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <h1>سوقنا 🛒</h1>
        <nav>
            <a href="index.html">الرئيسية</a>
            <a href="products.html">المنتجات</a>
            <a href="cart.html">السلة</a>
            <a href="login.html">تسجيل الدخول</a>
        </nav>
    </header>

    <section style="max-width: 450px; margin: 50px auto; background: #ffffff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08);">
        <h2 style="text-align: center; color: #0f172a; margin-bottom: 20px;">تسجيل الدخول 👤</h2>
        
        <form onsubmit="loginUser(event)">
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">الاسم الكامل:</label>
                <input type="text" id="username" required placeholder="أدخل اسمك هنا..." style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px;">
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">البريد الإلكتروني:</label>
                <input type="email" id="email" required placeholder="example@mail.com" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px;">
            </div>

            <button type="submit" style="width: 100%; padding: 12px; font-size: 16px;">دخول للمتجر</button>
        </form>
    </section>

    <script src="script.js"></script>
</body>
</html>